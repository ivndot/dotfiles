{
  "layer": "top",
  "position": "top",
  "height": 40,
  "margin-left": 20,
  "margin-right": 20,
  "margin-top": 10,
  "margin-bottom": 15,
  "spacing": 10,
  "reload_style_on_change": true,

  /**
  *=============================
  * MODULES POSITION CONFIG
  *=============================
  **/
  "modules-left": [  
    "group/sysinfo",
    "group/player"
  ],
  "modules-center": [
    "group/workspaces"
  ],
  "modules-right": [
    "group/sysstatus",
    "group/connectivity"
  ],

  /**
  *=============================
  * GROUPS DEFINITION CONFIG
  *=============================
  **/
  "group/workspaces": {
    "orientation": "horizontal",
    "modules": [
      "hyprland/workspaces"
    ]
  },
  "group/sysinfo": {
    "orientation": "horizontal",
    "modules": [
      "cpu",
      "temperature",
      "disk",
      "memory"
    ]
  },
  "group/sysstatus": {
    "orientation": "horizontal",
    "modules": [
      "clock",
      "backlight",
      "battery"
    ]
  },
  "group/connectivity": {
    "orientation": "horizontal",
    "modules": [
      "keyboard-state",
      "bluetooth",
      "network",
      "custom/power"
    ]
  },
  "group/player": {
    "orientation": "horizontal",
    "modules": [
      "mpris",
      "custom/previous",
      "custom/pause",
      "custom/next",
      //"wireplumber",
      "pulseaudio" 
    ]
  },

  /**
  *=============================
  * LEFT MODULES IMPLEMENTATION
  *=============================
  **/
  "cpu": {
    "interval": 2,
    "format": " {usage:>2}%"
  },
  "temperature": {
    "thermal-zone": 2,
    //"hwmon-path": "/sys/class/hwmon/hwmon2/temp1_input", --> to change
    "format-critical": "{temperatureC}°C {icon}",
    "critical-threshold": 80,
    "interval": 2,
    "format": "{icon} {temperatureC:>2}°C",
    "format-icons": ["", "", ""],
    "on-click": "kitty -e zsh -c 'btop; exec zsh'"
  },
  "disk": { 
    "interval": 15, "format": "󰋊 {percentage_used:>2}%"
  },
  "memory": {
    "interval": 2,
    "format": " {:>2}%"
  },
  "keyboard-state": {
    "numlock": false,
    "capslock": true,
    "format": "{icon}",
    "format-icons": {
      "locked": " ",
      "unlocked": " "
    }
  },
   "mpris": {
     "format": "{player_icon} {title} - {artist} ",
     "format-paused": "{status_icon} {title} - {artist}",
     "player-icons": {
       "default": "<span foreground='#cba6f7'>󰝚 </span>",
       "spotify": "<span foreground='#a6e3a1'>󰓇 </span>",
       "firefox": "<span foreground='#f38ba8'>󰗃 </span>"
     },
     "status-icons": {
       "paused": "<span color='#b4befe'>\u200A\u200A󰏤\u2009\u2009</span>"
     },
     "tooltip-format": "Playing: {title} - {artist}",
     "tooltip-format-paused": "Paused: {title} - {artist}",
     "min-length": 5,
     "max-length": 18
   },
  "custom/previous": {
    "format": "󰙣",
    "on-click": "playerctl --player=firefox previous",
    "tooltip": false
  },
  "custom/pause": {
    "format": "{icon}",
    "on-click": "playerctl --player=firefox play-pause",
    "tooltip": false,
    "format-icons": [ "", "" ]
  },
  "custom/next": {
    "format": "󰙡 ",
    "on-click": "playerctl --player=firefox next",
    "tooltip": false
  },
  "wireplumber": {
    "format": "{icon} {volume:>3}%",
    "format-muted": "󰖁 {volume:>3}%",
    "format-bluetooth": "{icon} {volume:>2}% 󰂯",
    "format-bluetooth-muted": "󰖁 {icon} 󰂯",
    "format-icons": ["", "", ""]
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-bluetooth": "{icon} {volume}% 󰂯",
    "format-bluetooth-muted": "󰖁 {icon} 󰂯",
    "format-muted": "󰖁 {volume}%",
    "format-source": " {volume}%",
    "format-source-muted": "",
    "format-icons": {
      "headphone": "󰋋",
      "hands-free": "󱡒",
      "headset": "󰋎",
      "phone": "",
      "portable": "",
      "car": "",
      "default": ["", "", ""]
    },
    "on-click": "pavucontrol"
  },

  /**
  *==============================
  * CENTER MODULES IMPLEMENTATION
  *==============================
  **/
  "hyprland/workspaces": {
    "on-click": "activate",
    "activate-only": false,
    "all-outputs": false,
    "format": "{icon}",
    "format-icons": {
      "default": "",
      "active": "󰮯",
      "urgent": "!"
    },
    "persistent-workspaces": {
      "*": 4
    }
  },

  /**
  *==============================
  * RIGHT MODULES IMPLEMENTATION
  *==============================
  **/
  "clock": {
    "format": "󱛡 {:%I:%M %p | %d %B - %A}",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
    "format-alt": "{:%Y-%m-%d}"
  },
  "backlight": {
    // "device": "acpi_video1", --> to change
    "format": "{icon} {percent:>2}%",
    "format-icons": [ "", "", "", "", "", "", "", "", ""]
  },
  "battery": {
    "states": {
      "good": 95,
      "warning": 30,
      "critical": 15
    },
    "format": "{icon}",
    "format-full": "{icon}",
    "format-plugged": " {capacity}% <span font='Font Awesome 5 Free'>\uf0e7</span> ",
    "format-alt": "{icon} {capacity}%",
    "tooltip-format": "{capacity}%, about {time} left",
    "format-icons": ["", "", "", ""]
  },
  "bluetooth": {
    "format": "{icon}",
    "format-icons": ["󰂯", "󰤾", "󰥀", "󰥄", "󰥈"],
    "tooltip-format-off": "Bluetooth is off",
    "tooltip-format-on": "Bluetooth is on",
    "format-connected": "{icon} {num_connections}",
    "format-connected-battery": "{icon} {device_battery_percentage}%",
    "tooltip-format-connected": "{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}\t{device_battery_percentage}%",
    "on-click": "blueman-manager"
  },
  "network": {
        "interval": 3,
        "format-wifi": "{icon}", 
        "format-ethernet": "󰌗 {ipaddr}", 
        "format-linked": "󰌙 {ifname} (Sin IP)", 
        "format-disconnected": "󰖪", 
        "format-alt": "󰛳 {ifname}", 
        "tooltip-format-wifi": " {bandwidthDownBytes}  {bandwidthUpBytes}", 
        "tooltip-format-ethernet": "󰌗 {ifname} | IP: {ipaddr}/{cidr} | GW: {gwaddr}", 
        "tooltip-format-disconnected": "󰖪 No internet connection", 
        "tooltip-format-linked": "󰌙 {ifname}: Not ip",
        "max-length": 30, 
        "on-click": "~/.config/rofi/wifi/script.sh", 
        "format-icons": {
            "wifi": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"], 
            "ethernet": ["󰌗"], 
            "disconnected": ["󰖪"] 
        }
    },
  "custom/power": {
    "format": "{icon}",
    "format-icons": "", 
    "exec-on-event": "true",
    "on-click": "wlogout",
    "tooltip-format": "Power Menu"
  },

  /**
  *==============================
  * NOT IN USE
  *==============================
  **/
  "custom/notification": {
    "tooltip": false,
    "format": " 󰂚",
    "format-icons": {
      "notification": "󰂚<span foreground='red'><sup></sup></span>",
      "none": "",
      "dnd-notification": "<span foreground='red'><sup></sup></span>",
      "dnd-none": "",
      "inhibited-notification": "<span foreground='red'><sup></sup></span>",
      "inhibited-none": "",
      "dnd-inhibited-notification": "<span foreground='red'><sup></sup></span>",
      "dnd-inhibited-none": ""
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true
  },
  "wlr/taskbar": {
    "format": "{icon}",
    "icon-size": 18,
    "tooltip-format": "{title}",
    "on-click": "activate",
    "on-click-middle": "close",
    "ignore-list": [ "kitty", "Alacritty" ]
  }
} 
